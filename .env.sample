#ident "@(#)$Format:DEVOP1:.env.sample:%an:%ae:%ad:%cn:%ce:%cd:%H:%D:%N$"
# .env.sample
# 
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.sample .env
# 2. Configure the passwords, email credentials, and webhook integration URLs.
# 3. Save the file and run the installation procedure.

# ------------------------------------------
# 1. NETWORK & ENVIRONMENT MODE
# ------------------------------------------
# NETWORK_MODE: Controls execution mode.
# Possible values: 'local' (offline development/testing) or 'server' (normal execution).
NETWORK_MODE=local
LLM_MODEL=llama3.2:11b

# ------------------------------------------
# 2. DATABASE CREDENTIALS (MySQL)
# ------------------------------------------
# Passwords for MySQL access
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
DB_READER_PASS=your_db_reader_password_here
DB_LOADER_PASS=your_db_loader_password_here
DB_APP_AUTH_PASS=your_db_app_auth_password_here
DB_ROOT_PASSWORD=your_db_root_password_here
DB_NAME=devop1_db
DB_USER=dev_user
DB_PASSWORD=your_db_password_here

# ------------------------------------------
# 3. TELEMETRY & ALERT TOGGLES
# ------------------------------------------
# Enable/disable alert notification routes (true/false)
ENABLE_MAIL=false
ENABLE_DISCORD=false
ENABLE_TEAMS=false

# ------------------------------------------
# 4. ZABBIX & SNMP CREDENTIALS
# ------------------------------------------
# Credentials for the Zabbix API and SNMP Traps
ZABBIX_USER=Admin
ZABBIX_PASS=zabbix
ZABBIX_SNMP_USER=zabbix_snmp
ZABBIX_SNMP_AUTHKEY=your_snmp_authkey_here
ZABBIX_SNMP_PRIVKEY=your_snmp_privkey_here
MYSQL_ZABBIX_PASSWORD=your_mysql_zabbix_password_here

# Webhook URLs (e.g. Discord, Teams)
DISCORD_WEBHOOK=your_discord_webhook_url_here
DISCORD_WEBHOOK_URL=your_discord_channel_url_here
TEAMS_WEBHOOK_URL=your_teams_webhook_url_here

# ------------------------------------------
# 5. EMAIL ALERTS CONFIGURATION
# ------------------------------------------
# SMTP connection configuration for alerts
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password_or_app_token_here

# ------------------------------------------
# 6. TAIGA PROJECT MANAGEMENT CREDENTIALS
# ------------------------------------------
TAIGA_API_URL=https://api.taiga.io/api/v1
TAIGA_USERNAME=your_taiga_username_here
TAIGA_PASSWORD=your_taiga_password_here
TAIGA_PROJECT_ID=your_taiga_project_id_here

# ------------------------------------------
# 7. SERVER DEPLOYMENT CREDENTIALS
# ------------------------------------------
SERVER_USER=your_server_user_here
SERVER_PASS=your_server_password_here

# ------------------------------------------
# 8. DYNAMIC PORT OFFSET
# ------------------------------------------
PORT_OFFSET=1000

BACKEND_PORT=6000
MYSQL_PORT=4306
AIRFLOW_PORT=9080
ZABBIX_PORT=9081
JENKINS_PORT=9088

# ------------------------------------------
# 9. XAU APPLICATION CREDENTIALS
# ------------------------------------------
XAU_DB_USER=xau
XAU_DB_PASSWORD=lanfr144
XAU_DB_NAME=xau
XAU_DB_HOST=db

# ------------------------------------------
# 10. SERVICE ENDPOINTS & CONNECTION STRINGS
# ------------------------------------------
BACKEND_URL=http://localhost:6000
MYSQL_APP_CONN_STRING=mysql://dev_user:your_db_password_here@localhost:4306/devop1_db
MYSQL_XAU_CONN_STRING=mysql://xau:lanfr144@localhost:4306/xau
AIRFLOW_URL=http://localhost:9080
ZABBIX_URL=http://localhost:9081
ZABBIX_TRAPPER_HOST=localhost:10051
JENKINS_URL=http://localhost:9088
